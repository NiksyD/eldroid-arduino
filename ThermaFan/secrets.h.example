#ifndef SECRETS_H
#define SECRETS_H

// Wi-Fi Credentials
#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Firebase Realtime Database Credentials
// Host format: "your-project-id-default-rtdb.firebaseio.com" (without https:// or trailing slashes)
#define FIREBASE_HOST "YOUR_FIREBASE_PROJECT_ID.firebaseio.com"
// Database secret or legacy auth token from Firebase Console -> Project Settings -> Service Accounts -> Database Secrets
#define FIREBASE_AUTH "YOUR_FIREBASE_DATABASE_SECRET"

#endif // SECRETS_H
